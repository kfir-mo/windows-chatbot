<UserControl x:Class="Chat.ChatTypesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Chat"
 FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Ink}" Background="{DynamicResource Canvas}" PreviewKeyDown="DialogKeyDown">
 <UserControl.Resources>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="Optional" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Bottom"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
  <Style x:Key="Placeholder" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="13.5,0"/><Setter Property="FontSize" Value="14"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Screen header: close and title. -->
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="60" Padding="8,0,12,0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource Ink}" Click="Dismiss" ToolTip="סגירה" AutomationProperties.Name="סגירה בלי לשמור"><local:Icon Kind="close" Size="20" StrokeWidth="2"/></Button>
    <TextBlock x:Name="Heading" Text="עוזר אישי חדש" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
   </StackPanel>
  </Border>

  <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Fields" Margin="16,14,16,16">
    <!-- Identity: avatar (opens the inline color and symbol picker) and the name. -->
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="AvatarButton" Width="60" Height="60" Padding="0" Background="Transparent" local:Ui.HoverBrush="Transparent" VerticalAlignment="Bottom" Click="ToggleLook" ToolTip="שינוי סמל וצבע" AutomationProperties.Name="בחירת סמל וצבע">
      <Grid Width="60" Height="60">
       <Border x:Name="AvatarFace" Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"><local:Icon x:Name="AvatarIcon" Kind="folder" Size="26" TextElement.Foreground="White"/></Border>
       <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Canvas}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"><local:Icon Kind="pen" Size="11" StrokeWidth="2.4" TextElement.Foreground="White"/></Border>
      </Grid>
     </Button>
     <StackPanel Grid.Column="1" Margin="12,0,0,0">
      <TextBlock Text="שם העוזר" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
      <Grid><TextBox x:Name="TypeName" Style="{StaticResource FieldBox}" MaxLength="60" TextChanged="NameChanged" AutomationProperties.Name="שם העוזר (חובה)" AutomationProperties.IsRequiredForForm="True"/>
       <TextBlock x:Name="NameHint" Text="מאגר מידע" Style="{StaticResource Placeholder}"/></Grid>
     </StackPanel>
    </Grid>
    <!-- Color and symbol: folded until the avatar is pressed. -->
    <Border x:Name="LookCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,12,14,6" Margin="0,12,0,0" Visibility="Collapsed">
     <Grid>
      <ContentControl x:Name="LookHost" Focusable="False"/>
      <!-- Right in a right-to-left layout is the visual left: the close button sits at the far end of the "צבע" line. -->
      <Button x:Name="CloseLookButton" Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-6,0" Foreground="{DynamicResource Danger}" local:Ui.HoverBrush="{DynamicResource DangerSoft}" Click="CloseLook" ToolTip="סגירה" AutomationProperties.Name="סגירת בחירת הסמל והצבע"><local:Icon Kind="close" Size="16" StrokeWidth="2.6"/></Button>
     </Grid>
    </Border>

    <!-- Sources: folders or single documents, as many as wanted; each is scanned and shows its real document count. -->
    <StackPanel Orientation="Horizontal" Margin="0,18,0,4"><TextBlock Text="מסמכים" Style="{StaticResource FieldLabel}"/><TextBlock Text="(לא חובה)" Style="{StaticResource Optional}"/></StackPanel>
    <TextBlock Text="העוזר יענה מתוך התיקיות והקבצים שתוסיפו." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
    <Grid x:Name="EmptyFolders">
     <Rectangle RadiusX="14" RadiusY="14" Stroke="#C3C8D0" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="{DynamicResource Surface}"/>
     <StackPanel Margin="12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid FlowDirection="LeftToRight"><TextBox x:Name="FirstPath" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" FontSize="13" KeyDown="FirstPathKey" TextChanged="PathTyped" AutomationProperties.Name="נתיב תיקייה או קובץ"/>
        <TextBlock x:Name="FirstPathHint" Text="C:\Docs" Style="{StaticResource Placeholder}" FontFamily="{StaticResource MonoFont}" FontSize="13" HorizontalAlignment="Left"/></Grid>
       <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinHeight="44" Padding="10,0" Click="BrowseFirst" ToolTip="בחירת תיקייה" AutomationProperties.Name="עיון: בחירת תיקייה"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder" Size="16" StrokeWidth="2" Margin="0,0,6,0"/><TextBlock Text="עיון" VerticalAlignment="Center"/></StackPanel></Button>
       <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" MinHeight="44" Width="44" Padding="0" Click="BrowseFileFirst" ToolTip="בחירת מסמך מסוים" AutomationProperties.Name="בחירת מסמך מסוים"><local:Icon Kind="file" Size="18" StrokeWidth="2"/></Button>
      </Grid>
      <Button Style="{StaticResource AssistantButton}" Content="הוספה" MinHeight="40" Padding="18,6" Margin="0,10,0,0" HorizontalAlignment="Left" Click="AddFirst" AutomationProperties.Name="הוספת הנתיב"/>
     </StackPanel>
    </Grid>
    <Border x:Name="FolderCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
     <StackPanel>
      <StackPanel x:Name="PathRows"/>
      <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
       <Grid>
        <Button x:Name="AddFolderButton" Style="{StaticResource RowButton}" local:Ui.CornerRadius="0,0,14,14" HorizontalContentAlignment="Center" Foreground="{DynamicResource Link}" Click="ShowAddFolder" AutomationProperties.Name="הוספת תיקייה או מסמך">
         <StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Size="17" StrokeWidth="2.2" Margin="0,0,6,0"/><TextBlock Text="הוספת תיקייה או מסמך" FontWeight="SemiBold"/></StackPanel>
        </Button>
        <StackPanel x:Name="AddFolderPanel" Margin="12" Visibility="Collapsed">
         <TextBlock Text="נתיב התיקייה או המסמך" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid FlowDirection="LeftToRight"><TextBox x:Name="NewPath" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" FontSize="13" KeyDown="NewPathKey" TextChanged="PathTyped" AutomationProperties.Name="נתיב תיקייה או קובץ"/>
           <TextBlock x:Name="NewPathHint" Text="C:\Docs" Style="{StaticResource Placeholder}" FontFamily="{StaticResource MonoFont}" FontSize="13" HorizontalAlignment="Left"/></Grid>
          <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinHeight="44" Padding="10,0" Click="BrowseNew" ToolTip="בחירת תיקייה" AutomationProperties.Name="עיון: בחירת תיקייה"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder" Size="16" StrokeWidth="2" Margin="0,0,6,0"/><TextBlock Text="עיון" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" MinHeight="44" Width="44" Padding="0" Click="BrowseFileNew" ToolTip="בחירת מסמך מסוים" AutomationProperties.Name="בחירת מסמך מסוים"><local:Icon Kind="file" Size="18" StrokeWidth="2"/></Button>
         </Grid>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
          <Button Style="{StaticResource AssistantButton}" x:Name="AddNewButton" Content="הוספה" MinHeight="40" Padding="18,6" Click="AddNew"/>
          <Button Style="{StaticResource GhostButton}" Content="ביטול" MinHeight="40" Padding="14,6" Margin="6,0,0,0" Click="CancelAddFolder" AutomationProperties.Name="ביטול הוספת התיקייה"/>
         </StackPanel>
        </StackPanel>
       </Grid>
      </Border>
     </StackPanel>
    </Border>
    <TextBlock x:Name="PathFeedback" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>

    <StackPanel Orientation="Horizontal" Margin="0,18,0,8"><TextBlock Text="הנחיות לעוזר" Style="{StaticResource FieldLabel}"/><TextBlock Text="(לא חובה)" Style="{StaticResource Optional}"/></StackPanel>
    <Grid><TextBox x:Name="CustomPrompt" Style="{StaticResource FieldBox}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="6000" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8" TextChanged="PromptChanged" AutomationProperties.Name="הנחיות לעוזר (לא חובה)"/>
     <TextBlock x:Name="PromptHint" Text="לדוגמה: תענה בעברית פשוטה ובקצרה." Style="{StaticResource Placeholder}" VerticalAlignment="Top" Margin="13.5,9.5,13.5,0" TextWrapping="Wrap"/></Grid>

    <!-- Edit only: delete, behind a confirmation. -->
    <Border x:Name="DangerCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,18,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="מחיקת העוזר" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><TextBlock Text="הקבצים שבתיקיות לא יימחקו" FontSize="12.5" Foreground="{DynamicResource Secondary}" Margin="0,2,0,0"/></StackPanel>
      <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource DangerOutlineButton}" Content="מחיקה" Padding="18,6" Click="DeleteType" AutomationProperties.Name="מחיקת העוזר"/>
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <!-- Sticky footer. -->
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
   <StackPanel>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" FontSize="12.5" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="CheckButton" Style="{StaticResource PrimaryButton}" Content="יצירת עוזר" Click="Save"/>
     <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="ביטול" MinHeight="46" Margin="8,0,0,0" Click="Dismiss"/>
    </Grid>
   </StackPanel>
  </Border>

  <!-- Delete confirmation over the form. -->
  <Grid x:Name="ConfirmLayer" Grid.RowSpan="3" Visibility="Collapsed">
   <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="ConfirmScrimClicked"/>
   <Border Background="{DynamicResource Surface}" CornerRadius="18" Margin="20" Padding="20,18" VerticalAlignment="Center" AutomationProperties.Name="אישור מחיקת העוזר" KeyboardNavigation.TabNavigation="Cycle">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" Color="#1B1F27"/></Border.Effect>
    <StackPanel>
     <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource DangerSoft}" HorizontalAlignment="Left"><local:Icon Kind="trash" Size="22" TextElement.Foreground="{DynamicResource Danger}"/></Border>
     <TextBlock x:Name="ConfirmTitle" Text="למחוק את העוזר?" FontSize="17" FontWeight="Bold" Margin="0,12,0,6" TextWrapping="Wrap"/>
     <TextBlock Text="העוזר וההגדרות שלו יימחקו. הקבצים שבתיקיות לא יימחקו." Style="{StaticResource Hint}" FontSize="13.5"/>
     <CheckBox x:Name="DeleteHistory" Margin="0,14,0,0" Visibility="Collapsed" VerticalContentAlignment="Top" AutomationProperties.Name="למחוק גם את השיחות עם עוזר זה מהיסטוריית השיחות"><TextBlock x:Name="DeleteHistoryText" TextWrapping="Wrap" FontSize="13.5" Margin="4,0,0,0"/></CheckBox>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="ConfirmDeleteButton" Style="{StaticResource PrimaryButton}" Background="{DynamicResource Danger}" Content="מחיקה" Click="ConfirmDelete" AutomationProperties.Name="אישור מחיקת העוזר"/>
      <Button x:Name="CancelDeleteButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="ביטול" MinHeight="46" Margin="8,0,0,0" Click="CancelDelete" AutomationProperties.Name="ביטול המחיקה"/>
     </Grid>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
