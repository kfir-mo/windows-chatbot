<Window x:Class="Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Chat"
        Title="Chaty" Icon="chaty.ico" Width="400" Height="680" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}" KeyDown="WindowKeyDown">
 <Window.Resources>
  <Geometry x:Key="ChatShape">M 3,2 L 21,2 Q 24,2 24,5 L 24,16 Q 24,19 21,19 L 11,19 L 5,24 L 5,19 L 3,19 Q 0,19 0,16 L 0,5 Q 0,2 3,2 Z</Geometry>
  <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Secondary}"/></Style>
  <!-- Send: grey and disabled while the box is empty, the assistant's color once there is text. -->
  <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Background" Value="{DynamicResource AssistantBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="local:Ui.CornerRadius" Value="12"/><Setter Property="local:Ui.HoverBrush" Value="#1F000000"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12"/><Border x:Name="Hover" Background="#1F000000" CornerRadius="12" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Disabled}"/><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Hover" Property="Opacity" Value="0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=CancelButton}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="16,16,16,12" FlowDirection="LeftToRight">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="LauncherRow" Height="72"/></Grid.RowDefinitions>
  <Border x:Name="Panel" FlowDirection="RightToLeft" Background="{DynamicResource Canvas}" CornerRadius="18" Visibility="Collapsed" RenderTransformOrigin="0.08,1">
   <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.16" Color="#1B1F27"/></Border.Effect>
   <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="PanelScale"/><TranslateTransform x:Name="PanelSlide"/></TransformGroup></Border.RenderTransform>
   <Grid x:Name="PanelRoot">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>

    <!-- Header: solid in the active assistant's color, white text and icons. -->
    <Border x:Name="HeaderBar" Background="{DynamicResource AssistantBrush}" Padding="10,0,8,0" MouseLeftButtonDown="BackgroundDoubleClick">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <!-- Symbol and name are one block: it lights up as a whole while the assistant switcher is open. -->
      <Border x:Name="IdentityGroup" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="2"><StackPanel Orientation="Horizontal">
      <Button x:Name="LookButton" Style="{StaticResource HeaderIconButton}" local:Ui.CornerRadius="12" Background="Transparent" VerticalAlignment="Center" Click="PickLook" ToolTip="מראה העוזר" AutomationProperties.Name="שינוי סמל וצבע">
       <!-- Hovering the symbol shows a small pencil: it opens the icon and color picker. -->
       <Grid Width="40" Height="40"><local:Icon x:Name="HeaderIcon" Kind="chat" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Width="16" Height="16" CornerRadius="8" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" IsHitTestVisible="False">
         <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=LookButton}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <local:Icon Kind="pen" Size="9" StrokeWidth="2.6" TextElement.Foreground="{DynamicResource AssistantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       </Grid></Button>
      <Button x:Name="ChatTypePicker" Style="{StaticResource HeaderIconButton}" Width="Auto" Height="Auto" MinHeight="44" Padding="8,2" Margin="2,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" FontFamily="{StaticResource UiFont}" Click="PickChatType" ToolTip="החלפת עוזר" AutomationProperties.Name="החלפת עוזר">
       <StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="ChatTypeName" Text="כללי" FontSize="15" FontWeight="Bold" MaxWidth="150" TextTrimming="CharacterEllipsis"/><local:Icon x:Name="PickerChevron" Kind="chevron-down" Size="14" StrokeWidth="2.2" Margin="6,2,0,0" VerticalAlignment="Center"/></StackPanel>
        <TextBlock x:Name="Status" Text="שיחה חופשית עם AI" FontSize="12.5" Opacity="0.92" Margin="0,1,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000"/>
       </StackPanel>
      </Button>
      </StackPanel></Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="NewChatButton" Style="{StaticResource HeaderIconButton}" ToolTip="שיחה חדשה" AutomationProperties.Name="שיחה חדשה" Click="NewChat"><local:Icon Kind="plus" Size="20" StrokeWidth="2"/></Button>
       <Button x:Name="HistoryTab" Style="{StaticResource HeaderIconButton}" ToolTip="היסטוריה" AutomationProperties.Name="היסטוריה" Click="History"><local:Icon Kind="history" Size="20" StrokeWidth="2"/></Button>
       <Button x:Name="MenuButton" Style="{StaticResource HeaderIconButton}" ToolTip="תפריט" AutomationProperties.Name="תפריט" Click="ShowOptions"><local:Icon Kind="more" Size="20"/></Button>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Body -->
    <Grid x:Name="ChatPage" Grid.Row="1">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,8,4">
      <StackPanel>
       <!-- Landing page: general chat or the assistant's own page (folders, recent questions). -->
       <StackPanel x:Name="Welcome" Margin="6,6,6,6">
        <Border x:Name="WelcomeTile" Width="48" Height="48" CornerRadius="14" Background="#DBEAFE" HorizontalAlignment="Center" Margin="0,0,0,10"><local:Icon x:Name="WelcomeIcon" Kind="chat" Size="24" TextElement.Foreground="#2563EB"/></Border>
        <TextBlock x:Name="WelcomeTitle" Text="במה אפשר לעזור?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="WelcomeText" Foreground="{DynamicResource Secondary}" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Center" Margin="0,8,0,0" LineHeight="20"/>
        <WrapPanel x:Name="WelcomeSources" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <StackPanel x:Name="RecentSection" Margin="0,20,0,0" Visibility="Collapsed">
         <Grid Margin="2,0,0,8"><TextBlock Text="שאלות אחרונות" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
          <Button x:Name="AllConversations" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,-6,-6,-6" Content="לכל השיחות" Foreground="{DynamicResource AssistantBrush}" Click="History" AutomationProperties.Name="לכל השיחות"/></Grid>
         <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"><StackPanel x:Name="RecentList"/></Border>
        </StackPanel>
        <StackPanel x:Name="SuggestionSection" Margin="0,16,0,0">
         <TextBlock Text="נסו לשאול" Style="{StaticResource SectionLabel}" Margin="2,0,0,8"/>
         <StackPanel x:Name="Suggestions"/>
        </StackPanel>
        <Button x:Name="PromoCard" Style="{StaticResource RowButton}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" local:Ui.CornerRadius="14" Padding="10" Margin="0,14,0,0" Click="CreateAssistant" AutomationProperties.Name="רוצים תשובות מהמסמכים שלכם? צרו עוזר אישי">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="10" Background="#FDEEE6"><local:Icon Kind="folder" Size="20" TextElement.Foreground="#C2410C"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="רוצים תשובות מהמסמכים שלכם?" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="צרו עוזר אישי וחברו אליו תיקיות" FontSize="12.5" Foreground="{DynamicResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <local:Icon Grid.Column="2" Kind="chevron-left" Size="18" StrokeWidth="2" TextElement.Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </StackPanel>
       <StackPanel x:Name="Messages"/>
       <Grid x:Name="Typing" Visibility="Collapsed" Margin="0,6,0,12" AutomationProperties.Name="Chaty מכין תשובה">
        <Grid.Resources><Storyboard x:Key="TypingMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3" AutoReverse="True"/></Storyboard></Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AssistantBrush}" VerticalAlignment="Bottom" Margin="7,0,0,0"><Path Data="{StaticResource ChatShape}" Fill="White" Width="12" Height="11" Stretch="Uniform"/></Border>
        <Border HorizontalAlignment="Right" Background="{DynamicResource Surface}" CornerRadius="16,16,4,16" Padding="12,9">
         <StackPanel Orientation="Horizontal"><Ellipse x:Name="Dot1" Width="7" Height="7" Fill="{DynamicResource AssistantBrush}" Margin="2,0"/><Ellipse x:Name="Dot2" Width="7" Height="7" Fill="{DynamicResource AssistantBrush}" Margin="2,0"/><Ellipse x:Name="Dot3" Width="7" Height="7" Fill="{DynamicResource AssistantBrush}" Margin="2,0"/>
          <TextBlock Text="{Binding Text, ElementName=Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
        </Border>
       </Grid>
      </StackPanel>
     </ScrollViewer>

     <!-- Composer: one row in general chat; assistants with folders add the fast/deep switch under the text. -->
     <Border x:Name="Composer" Grid.Row="1" Margin="12,4,12,0" CornerRadius="16" BorderThickness="1.5" Padding="6" Background="{DynamicResource Surface}">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AssistantBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
      <Grid x:Name="ComposerGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="QuestionArea" VerticalAlignment="Center" Margin="8,0,6,0">
        <TextBox x:Name="Question" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="110" Padding="0,9" FontSize="14" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" PreviewKeyDown="QuestionKey" AutomationProperties.Name="כתבו הודעה"/>
        <TextBlock x:Name="QuestionHint" Text="כתבו הודעה…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="2,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Question}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <!-- Answer mode: a pill track; the chosen mode is a soft tile in the assistant's color with its name, the others are icons.
            In right-to-left order: fast, normal, deep. -->
       <Border x:Name="ModeSwitch" Grid.Row="1" Background="{DynamicResource Subtle}" CornerRadius="17" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,4,0,0" Visibility="Collapsed" AutomationProperties.Name="אופן התשובה">
        <StackPanel Orientation="Horizontal">
         <RadioButton x:Name="FastMode" Style="{StaticResource ModeSegment}" GroupName="AnswerMode" Checked="ModeChanged" ToolTip="מהיר" AutomationProperties.Name="מהיר"><StackPanel Orientation="Horizontal"><local:Icon Kind="bolt" Size="16" StrokeWidth="2.2"/><TextBlock x:Name="FastLabel" Text="מהיר" VerticalAlignment="Center" MaxWidth="0" Opacity="0"/></StackPanel></RadioButton>
         <RadioButton x:Name="NormalMode" Style="{StaticResource ModeSegment}" GroupName="AnswerMode" IsChecked="True" Checked="ModeChanged" ToolTip="רגיל" AutomationProperties.Name="רגיל"><StackPanel Orientation="Horizontal"><local:Icon Kind="gauge" Size="16" StrokeWidth="2.2"/><TextBlock x:Name="NormalLabel" Text="רגיל" VerticalAlignment="Center" Margin="6,0,2,0" MaxWidth="70"/></StackPanel></RadioButton>
         <RadioButton x:Name="DeepMode" Style="{StaticResource ModeSegment}" GroupName="AnswerMode" Checked="ModeChanged" ToolTip="מעמיק" AutomationProperties.Name="מעמיק"><StackPanel Orientation="Horizontal"><local:Icon Kind="search" Size="16" StrokeWidth="2.2"/><TextBlock x:Name="DeepLabel" Text="מעמיק" VerticalAlignment="Center" MaxWidth="0" Opacity="0"/></StackPanel></RadioButton>
        </StackPanel>
       </Border>
       <Grid x:Name="SendArea" Grid.Column="1" VerticalAlignment="Bottom">
        <Button x:Name="CancelButton" Style="{StaticResource IconButton}" local:Ui.CornerRadius="12" Background="{DynamicResource Subtle}" Foreground="{DynamicResource Ink}" Visibility="Collapsed" Click="Cancel" ToolTip="עצירה" AutomationProperties.Name="עצירת הפעולה"><local:Icon Kind="stop" Size="18"/></Button>
        <Button x:Name="SendButton" Style="{StaticResource SendButton}" Click="Send" ToolTip="שליחה · Enter" AutomationProperties.Name="שליחה"><local:Icon Kind="send" Size="20" StrokeWidth="2.2"/></Button>
       </Grid>
      </Grid>
     </Border>
     <TextBlock x:Name="Disclaimer" Grid.Row="2" Text="Chaty עלול לטעות. כדאי לבדוק מידע חשוב." FontSize="11.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12,6,12,8"/>
    </Grid>

    <!-- Popovers over the chat (assistant switcher, look, menu, about). The header stays visible above the dimmed body. -->
    <Grid x:Name="Overlay" Grid.Row="1" Panel.ZIndex="10" Visibility="Collapsed">
     <Border x:Name="Scrim" Background="{DynamicResource Scrim}" MouseLeftButtonDown="ScrimClicked"/>
     <ContentControl x:Name="OverlayHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>

    <!-- History replaces the chat under the header, so the top menu stays available. -->
    <local:HistoryPage x:Name="HistoryView" Grid.Row="1" Panel.ZIndex="5" Visibility="Collapsed"/>

    <!-- Full-panel screens (AI settings, assistant form) replace header and body. -->
    <Grid x:Name="ScreenLayer" Grid.RowSpan="2" Panel.ZIndex="20" Background="{DynamicResource Canvas}" Visibility="Collapsed">
     <ContentControl x:Name="ScreenHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>

    <Border x:Name="LoginOverlay" Grid.RowSpan="2" Panel.ZIndex="30" Background="{DynamicResource Surface}" Visibility="Visible" Padding="22">
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="ברוכים הבאים" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>
      <Border Background="{DynamicResource Selected}" CornerRadius="14" Padding="16"><TextBlock Text="אפליקציה זו מנוטרת על ידי הארגון" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/></Border>
      <TextBlock Text="השאלות, התשובות ונתוני השימוש נשמרים ביומן הארגוני. הגישה לשירות ולמקורות נקבעת לפי הרשאות חשבון הארגון שלכם." TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" Margin="0,16,0,18"/>
      <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="כניסה עם חשבון הארגון" Click="Login"/>
      <TextBlock x:Name="LoginStatus" Text="הכניסה משתמשת בחשבון Windows המחובר למחשב." FontSize="12" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <!-- Resize grips on the panel's top and left edges (the panel stays anchored to the launcher at the bottom right).
       Nearly transparent instead of transparent: fully transparent pixels of this window don't receive the mouse. -->
  <Border x:Name="TopGrip" Height="10" VerticalAlignment="Top" Margin="14,-6,0,0" Background="#01FFFFFF" Cursor="SizeNS" Panel.ZIndex="5" Visibility="{Binding Visibility, ElementName=Panel}" Tag="top" MouseLeftButtonDown="GripDown" MouseMove="GripMove" MouseLeftButtonUp="GripUp" ToolTip="גרירה לשינוי הגובה · לחיצה כפולה לגודל הרגיל"/>
  <Border x:Name="LeftGrip" Width="10" HorizontalAlignment="Left" Margin="-6,14,0,0" Background="#01FFFFFF" Cursor="SizeWE" Panel.ZIndex="5" Visibility="{Binding Visibility, ElementName=Panel}" Tag="left" MouseLeftButtonDown="GripDown" MouseMove="GripMove" MouseLeftButtonUp="GripUp" ToolTip="גרירה לשינוי הרוחב · לחיצה כפולה לגודל הרגיל"/>
  <Border x:Name="CornerGrip" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Background="#01FFFFFF" Cursor="SizeNWSE" Panel.ZIndex="6" Visibility="{Binding Visibility, ElementName=Panel}" Tag="corner" MouseLeftButtonDown="GripDown" MouseMove="GripMove" MouseLeftButtonUp="GripUp"/>

  <!-- Launcher: always visible, opens and closes the chat. -->
  <Button x:Name="Bubble" Focusable="False" Grid.Row="1" Width="54" Height="54" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Click="TogglePanel" ToolTip="פתיחת הצ׳אט" AutomationProperties.Name="פתיחה או סגירה של הצ׳אט" RenderTransformOrigin="0.5,0.5" FocusVisualStyle="{x:Null}">
   <Button.RenderTransform><ScaleTransform x:Name="BubbleScale"/></Button.RenderTransform>
   <Button.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#1D4ED8" Opacity="0.35"/></Button.Effect>
   <Button.Template><ControlTemplate TargetType="Button"><Grid>
    <Ellipse Fill="{StaticResource BrandBrush}"/><Ellipse x:Name="Shine" Fill="#26FFFFFF" Opacity="0"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Button.Template>
   <Button.Triggers>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
   </Button.Triggers>
   <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><RotateTransform x:Name="GlyphTurn"/></Grid.RenderTransform>
    <Path x:Name="ChatGlyph" Data="{StaticResource ChatShape}" Fill="White" Stretch="Uniform"/>
    <Path x:Name="CloseGlyph" Data="M 0,0 L 8,8 L 16,0" Width="16" Height="8" Stretch="Fill" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
   </Grid>
  </Button>
 </Grid>
</Window>
