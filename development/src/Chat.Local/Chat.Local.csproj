<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>../Chat/app.manifest</ApplicationManifest>
    <AssemblyName>Chaty</AssemblyName><ApplicationIcon>../Chat/chaty.ico</ApplicationIcon>
    <Product>Chaty</Product><AssemblyTitle>Chaty</AssemblyTitle><Description>Chaty</Description><Version>1.1.0</Version><DefineConstants>$(DefineConstants);LOCAL_PROTOTYPE</DefineConstants>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- Smaller exe and less memory: no localized framework resources (the UI is Hebrew text of its own), workstation GC
         without the background GC thread. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Knowledge.Core/Knowledge.Core.csproj"/>
    <Compile Include="../Chat/*.cs" Link="%(Filename)%(Extension)"/>
    <ApplicationDefinition Include="../Chat/App.xaml" Link="App.xaml"/>
    <Page Include="../Chat/*.xaml" Exclude="../Chat/App.xaml" Link="%(Filename)%(Extension)"/>
    <Resource Include="../Chat/chaty.ico" Link="chaty.ico"/>
  </ItemGroup>
</Project>
