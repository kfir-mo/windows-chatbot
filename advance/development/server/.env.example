# SERVER ONLY. Never distribute this file to users.
AI_ENDPOINT=
AI_MODEL=
AI_ALLOWED_HOSTS=
AI_FORMAT=chat-completions
AI_AUTHENTICATION=bearer
AI_API_KEY=
AI_SECRET_ENVIRONMENT_VARIABLE=INTERNAL_AI_KEY
AI_HEADER_NAME=api-key
AI_ALLOW_HTTP=false
AI_USE_PROXY=false
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1600
# Empty means OpenAI defaults for the selected format.
# chat-completions: usage.prompt_tokens / usage.completion_tokens
# responses: usage.input_tokens / usage.output_tokens
AI_INPUT_TOKENS_PATH=
AI_OUTPUT_TOKENS_PATH=
# HTTPS certificate for connections FROM desktop clients TO this server (.pfx).
SERVER_CERTIFICATE_PATH=
SERVER_CERTIFICATE_PASSWORD=
