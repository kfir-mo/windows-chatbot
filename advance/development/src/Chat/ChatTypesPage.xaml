<Window x:Class="Chat.ChatTypesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="הגדרת סוג צ׳אט" Width="480" SizeToContent="Height" MaxHeight="680" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FlowDirection="RightToLeft" FontFamily="Segoe UI" Foreground="{DynamicResource Ink}" PreviewKeyDown="DialogKeyDown">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8,3"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{DynamicResource Surface}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20" FlowDirection="LeftToRight"><TextBlock x:Name="Heading" Text="סוג צ׳אט חדש" FlowDirection="RightToLeft" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" Width="44" Height="44" AutomationProperties.Name="סגירה" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="23" Padding="7,0" Margin="0" Click="Dismiss" ToolTip="סגירה"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Fields">
    <TextBlock Text="שם העוזר *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="TypeName" Height="38" MaxLength="60" Margin="0,0,0,20" TextChanged="NameChanged"/>
    <TextBlock Text="תיקיות תיעוד · אופציונלי" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock Text="הוסיפו תיקייה מקומית או נתיב רשת." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,10"/>
    <StackPanel x:Name="PathRows"/><TextBlock x:Name="PathHint" Text="ללא נתיב, העוזר יענה ללא מסמכים." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
    <Button Content="+  הוספת נתיב נוסף" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Link}" Padding="0,8" Margin="0,0,0,12" Click="AddPath"/>
    <TextBlock Text="הנחיות ל־AI · אופציונלי" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Text="לדוגמה: ענה בקצרה ושמור שמות פקודות באנגלית." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/></Grid.RowDefinitions><TextBox x:Name="CustomPrompt" Height="100" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="6000" VerticalScrollBarVisibility="Auto" Margin="0"/><Thumb Grid.Row="1" Height="8" Cursor="SizeNS" DragDelta="ResizePrompt" Background="{DynamicResource Line}" ToolTip="גררו לשינוי גובה ההנחיות" AutomationProperties.Name="שינוי גובה ההנחיות"/></Grid>
    <Button x:Name="DeleteButton" HorizontalAlignment="Left" Foreground="{DynamicResource Danger}" Background="Transparent" Padding="0,8" Margin="0" Click="DeleteType"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="מחיקת העוזר"/></StackPanel></Button>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,12,0,0">
    <Button x:Name="CheckButton" Content="יצירת עוזר" Background="{DynamicResource Accent}" Foreground="White" Padding="12" Margin="0" Click="Save"/>
    <Button Content="ביטול" Background="Transparent" Click="Dismiss"/><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>




