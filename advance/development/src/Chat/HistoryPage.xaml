<UserControl x:Class="Chat.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <UserControl.Resources><Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger></Style.Triggers></Style></UserControl.Resources>
 <Grid Margin="0,20,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal">
   <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Accent}" Margin="0,0,10,0"><Path Data="M 3,2 L 21,2 Q 24,2 24,5 L 24,16 Q 24,19 21,19 L 11,19 L 5,24 L 5,19 L 3,19 Q 0,19 0,16 L 0,5 Q 0,2 3,2 Z" Fill="White" Width="20" Height="19" Stretch="Uniform"/></Border>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="ממשיכים את השיחה" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="ממשיכים בדיוק מאיפה שעצרתם" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
  </StackPanel>
  <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,16"><StackPanel Orientation="Horizontal" Margin="2,12,2,0"><TextBlock Text="השיחות שלכם" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/><Border Background="{DynamicResource Selected}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"><TextBlock x:Name="ConversationCount" Foreground="{DynamicResource Link}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel></Border>
  <Grid Grid.Row="2">
   <TextBlock x:Name="Empty" Text="אין עדיין שיחות שמורות" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="ConversationList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border CornerRadius="14" Margin="0,0,0,8" Padding="12,9" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Click="OpenConversation" Tag="{Binding}" Background="Transparent" Padding="0" Margin="0" ToolTip="פתיחת השיחה" AutomationProperties.Name="{Binding Title}">
        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border></ControlTemplate></Button.Template>
        <DockPanel><TextBlock Text="‹" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0" FontSize="20"/><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/><TextBlock Text="{Binding HistoryMetadata}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
       </Button>
       <Button Grid.Column="1" Width="44" Height="44" Style="{StaticResource DeleteAction}" Click="DeleteConversation" Tag="{Binding}" ToolTip="מחיקת השיחה" AutomationProperties.Name="מחיקת השיחה" Background="Transparent" Padding="8" Margin="8,0,0,0" VerticalAlignment="Center">
        <Path Data="M 3,5 L 15,5 M 6,5 L 6,2 L 12,2 L 12,5 M 4,5 L 5,18 L 13,18 L 14,5 M 8,8 L 8,15 M 10,8 L 10,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="18" Stretch="Uniform"/>
       </Button>
       <Border Grid.Row="1" Grid.ColumnSpan="2" Tag="confirmation" Visibility="Collapsed" Margin="0,8,0,0" Background="{DynamicResource Subtle}" CornerRadius="12" Padding="8">
        <StackPanel Orientation="Horizontal"><TextBlock Text="למחוק את השיחה?" VerticalAlignment="Center"/><Button Content="כן" Tag="{Binding}" Click="ConfirmDelete" Foreground="{DynamicResource Danger}" Background="Transparent"/><Button Content="ביטול" Click="CancelDelete" Background="Transparent"/></StackPanel>
       </Border>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
