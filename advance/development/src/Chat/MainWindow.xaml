<Window x:Class="Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Chat"
        Title="עוזר הידע" Width="428" Height="780" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Ink}">
 <Window.Resources>
  <Geometry x:Key="ChatShape">M 3,2 L 21,2 Q 24,2 24,5 L 24,16 Q 24,19 21,19 L 11,19 L 5,24 L 5,19 L 3,19 Q 0,19 0,16 L 0,5 Q 0,2 3,2 Z</Geometry>
  <Style x:Key="Pill" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Suggestion" TargetType="Button" BasedOn="{StaticResource Pill}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,8"/></Style>
  <DrawingImage x:Key="ChatIcon"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="#1673FF" Geometry="M 32,0 A 32,32 0 1 1 31.99,0 Z"/><GeometryDrawing Brush="White" Geometry="M 18,18 L 46,18 Q 49,18 49,21 L 49,38 Q 49,41 46,41 L 32,41 L 23,49 L 23,41 L 18,41 Q 15,41 15,38 L 15,21 Q 15,18 18,18 Z"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
 </Window.Resources>
 <Window.Icon><StaticResource ResourceKey="ChatIcon"/></Window.Icon>
 <Grid Margin="16" FlowDirection="LeftToRight">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="LauncherRow" Height="72"/></Grid.RowDefinitions>
  <Border x:Name="Panel" FlowDirection="RightToLeft" Background="{DynamicResource Surface}" CornerRadius="22" Visibility="Collapsed" RenderTransformOrigin="0.05,1">
   <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.13" Color="#183B65"/></Border.Effect>
   <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="PanelScale"/><TranslateTransform x:Name="PanelSlide"/></TransformGroup></Border.RenderTransform>
   <Grid Margin="16,14,16,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Style="{StaticResource Pill}" Background="{DynamicResource Subtle}" Foreground="{DynamicResource Link}" Content="⋮" FontSize="23" Width="44" Height="44" Padding="0" ToolTip="אפשרויות" Click="ShowOptions" AutomationProperties.Name="אפשרויות"/>
     <Border Grid.Column="1" Background="{DynamicResource Subtle}" CornerRadius="23" HorizontalAlignment="Center" FlowDirection="RightToLeft"><StackPanel Orientation="Horizontal" Margin="3">
      <Button x:Name="ChatTab" Style="{StaticResource Pill}" Background="{DynamicResource Accent}" Foreground="White" FontWeight="SemiBold" Click="FocusChat"><StackPanel Orientation="Horizontal"><Path x:Name="TabChatGlyph" Data="{StaticResource ChatShape}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="צ׳אט"/></StackPanel></Button>
      <Button x:Name="HistoryTab" Style="{StaticResource Pill}" Content="היסטוריית שיחות" FontSize="12" Padding="8,8" Click="History"/>
     </StackPanel></Border>
     <Button x:Name="HideButton" Width="44" Height="44" Grid.Column="2" Style="{StaticResource Pill}" Padding="10" ToolTip="סגירת הצ׳אט לבועה" Click="CollapsePanel" AutomationProperties.Name="סגירת הצ׳אט לבועה"><Path Data="M 2,2 L 14,14 M 14,2 L 2,14" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
    </Grid>
    <Grid x:Name="ChatPage" Grid.Row="1" Grid.RowSpan="7">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="2,18,2,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,10,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#27C7ED" Offset="0"/><GradientStop Color="#0875FA" Offset="1"/></LinearGradientBrush></Border.Background><Path Data="{StaticResource ChatShape}" Width="20" Height="19" Stretch="Uniform" Fill="White"/></Border>
     <StackPanel Grid.Column="1"><Button x:Name="ChatTypePicker" Style="{StaticResource Pill}" Padding="0,0,0,2" Margin="0" HorizontalAlignment="Left" Content="כללי  ▾" FontSize="16" FontWeight="SemiBold" Click="PickChatType" ToolTip="בחירת סוג צ׳אט"/><TextBlock Text="הידע הארגוני שלכם, בשיחה אחת" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
     <Button x:Name="NewChatButton" Grid.Column="2" Style="{StaticResource Pill}" Background="Transparent" Foreground="{DynamicResource Link}" Content="+" FontSize="23" Width="44" Height="44" Padding="0" VerticalAlignment="Top" ToolTip="פתיחת שיחה חדשה" AutomationProperties.Name="שיחה חדשה" Click="NewChat"/>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Subtle}" CornerRadius="12" Margin="0,0,0,4"><TextBlock x:Name="Status" Text="מוכן לשיחה" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"  TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="10,8"/></Border>
    <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8" Padding="0,0,8,0"><StackPanel><Border x:Name="Welcome" Background="{DynamicResource Subtle}" CornerRadius="16,16,4,16" HorizontalAlignment="Stretch" Padding="14,11" Margin="0,4,18,10"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Path Data="{StaticResource ChatShape}" Fill="{DynamicResource Accent}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="עוזר הידע" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBox Text="שלום! איך אפשר לעזור לכם היום?" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" TextAlignment="Left" HorizontalContentAlignment="Stretch"/></StackPanel></Border><StackPanel x:Name="Messages"/>
    <Border x:Name="Typing" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="{DynamicResource Subtle}" CornerRadius="16,16,4,16" Padding="14,11" Margin="0,4,18,10" AutomationProperties.Name="עוזר הידע מכין תשובה">
     <Border.Resources><Storyboard x:Key="TypingMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3" AutoReverse="True"/></Storyboard></Border.Resources>
     <StackPanel><TextBlock Text="עוזר הידע" Foreground="SlateGray" FontSize="12" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Ellipse x:Name="Dot1" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="2"/><Ellipse x:Name="Dot2" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="2"/><Ellipse x:Name="Dot3" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="2"/><TextBlock Text="מכין תשובה…" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"/></StackPanel></StackPanel>
    </Border>
    </StackPanel></ScrollViewer>
    <WrapPanel x:Name="Suggestions" Grid.Row="3" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" Margin="0,6,0,12">
    </WrapPanel>
    <Border x:Name="Composer" Grid.Row="5" CornerRadius="18" BorderThickness="1.5" Padding="12,10,12,7">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBox x:Name="Question" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="92" VerticalScrollBarVisibility="Auto" PreviewKeyDown="QuestionKey" FontSize="14"/>
       <TextBlock Text="כתבו את השאלה שלכם…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="2,2"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Question}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CancelButton" Style="{StaticResource Pill}" Content="ביטול" FontSize="12" Padding="8,3" Visibility="Collapsed" Click="Cancel"/></StackPanel>
       <Button x:Name="SendButton" Width="44" Height="44" Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Accent}" Padding="10" Click="Send" ToolTip="שליחה · Enter" AutomationProperties.Name="שלח"><Path Data="M 18,0 L 0,8 L 18,16 L 15,9 L 6,8 L 15,7 Z" Fill="White" Width="16" Height="16" Stretch="Uniform" FlowDirection="LeftToRight"/></Button>
      </Grid>
     </Grid>
    </Border>
    <TextBlock Grid.Row="6" Text="עוזר הידע  ·  תשובות עם מקורות" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
    <local:HistoryPage x:Name="HistoryView" Grid.Row="1" Grid.RowSpan="7" Visibility="Collapsed"/>
    <Border x:Name="MenuScrim" Grid.RowSpan="8" Panel.ZIndex="19" Background="#220F2544" CornerRadius="16" Visibility="Collapsed"/>
    <Border x:Name="SettingsOverlay" Grid.RowSpan="8" Panel.ZIndex="20" Background="#660F2544" CornerRadius="16" Visibility="Collapsed" Padding="8">
     <ContentControl x:Name="SettingsHost" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/>
    </Border>
    <Border x:Name="LoginOverlay" Grid.RowSpan="8" Background="{DynamicResource Surface}" CornerRadius="16" Visibility="Visible" Padding="22">
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="ברוכים הבאים" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Border Background="{DynamicResource Selected}" CornerRadius="14" Padding="16"><TextBlock Text="אפליקציה זו מנוטרת על ידי הארגון" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/></Border>
      <TextBlock Text="השאלות, התשובות ונתוני השימוש נשמרים ביומן הארגוני. הגישה לשירות ולמקורות נקבעת לפי הרשאות חשבון הארגון שלכם." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,18"/>
      <Button x:Name="LoginButton" Content="כניסה עם חשבון הארגון" Background="{DynamicResource Accent}" Foreground="White" Padding="14" Click="Login"/>
      <TextBlock x:Name="LoginStatus" Text="הכניסה משתמשת בחשבון Windows המחובר למחשב." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel>
    </Border>

   </Grid>
  </Border>
  <Button x:Name="Bubble" Grid.Row="1" Width="58" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Cursor="Hand" Click="TogglePanel" ToolTip="פתיחת הצ׳אט" AutomationProperties.Name="פתיחה או סגירה של הצ׳אט" RenderTransformOrigin="0.5,0.5">
   <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
   <Button.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#1763CC" Opacity="0.22"/></Button.Effect>
   <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="29"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
 
   <Grid Width="26" Height="26"><Path x:Name="ChatGlyph" Data="{StaticResource ChatShape}" Fill="White" Stretch="Uniform"/><Path x:Name="CloseGlyph" Data="M 4,4 L 22,22 M 22,4 L 4,22" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Grid>
  </Button>
 </Grid>
</Window>

