<UserControl x:Class="Chat.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Chat" FlowDirection="RightToLeft">
 <UserControl.Resources>
  <Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="local:Ui.HoverBrush" Value="#14C2364A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Margin="14,16,10,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,4,14">
   <StackPanel Orientation="Horizontal"><TextBlock Text="השיחות שלכם" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/><Border Background="{DynamicResource Selected}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ConversationCount" Foreground="{DynamicResource Link}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel>
   <TextBlock Text="בחרו שיחה כדי להמשיך בדיוק מאיפה שעצרתם" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
   <Grid Margin="0,10,0,0">
    <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Height="36">
     <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="30,0,10,0" VerticalContentAlignment="Center" FontSize="13" TextChanged="FilterChanged" AutomationProperties.Name="חיפוש בשיחות"/>
    </Border>
    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
    <TextBlock x:Name="SearchHint" Text="חיפוש בשיחות…" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0" IsHitTestVisible="False"/>
   </Grid>
   <WrapPanel x:Name="Filters" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Subtle}" HorizontalAlignment="Center"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock x:Name="EmptyTitle" Text="אין עדיין שיחות שמורות" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
    <TextBlock x:Name="EmptyDetail" Text="השיחות שלכם יופיעו כאן" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
   </StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <ItemsControl x:Name="ConversationList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border CornerRadius="14" Margin="0,0,0,8" Padding="6,6,6,6" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B9CBE6"/></Trigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Click="OpenConversation" Tag="{Binding Conversation}" Background="Transparent" Padding="6,4" MinHeight="0" HorizontalContentAlignment="Stretch" local:Ui.CornerRadius="10" ToolTip="פתיחת השיחה" AutomationProperties.Name="{Binding Conversation.Title}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="36" Height="36" CornerRadius="18" Background="{Binding Badge}" Margin="0,0,10,0" ToolTip="{Binding Conversation.ChatTypeName}"><TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Conversation.Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/><TextBlock Text="{Binding Conversation.HistoryMetadata}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Grid>
       </Button>
       <Button Grid.Column="1" Style="{StaticResource DeleteAction}" Content="&#xE74D;" Click="DeleteConversation" Tag="{Binding Conversation}" ToolTip="מחיקת השיחה" AutomationProperties.Name="מחיקת השיחה" Margin="6,0,0,0" VerticalAlignment="Center"/>
       <Border Grid.Row="1" Grid.ColumnSpan="2" Tag="confirmation" Visibility="Collapsed" Margin="4,6,4,2" Background="#FFF3F4" CornerRadius="10" Padding="10,4">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="למחוק את השיחה?" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
         <Button Grid.Column="1" Content="כן" Tag="{Binding Conversation}" Click="ConfirmDelete" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" MinHeight="32" Padding="12,4"/>
         <Button Grid.Column="2" Content="ביטול" Click="CancelDelete" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource Ink}" MinHeight="32" Padding="12,4"/>
        </Grid>
       </Border>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="4,8,4,0"/>
 </Grid>
</UserControl>
