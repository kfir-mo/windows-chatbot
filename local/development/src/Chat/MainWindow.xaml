<Window x:Class="Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Chat"
        Title="Chaty" Icon="chaty.ico" Width="400" Height="680" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Ink}" KeyDown="WindowKeyDown">
 <Window.Resources>
  <Geometry x:Key="ChatShape">M 3,2 L 21,2 Q 24,2 24,5 L 24,16 Q 24,19 21,19 L 11,19 L 5,24 L 5,19 L 3,19 Q 0,19 0,16 L 0,5 Q 0,2 3,2 Z</Geometry>
  <Style x:Key="Suggestion" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="local:Ui.CornerRadius" Value="14"/><Setter Property="local:Ui.HoverBrush" Value="#141F6FFF"/>
  </Style>
  <Style x:Key="ModeTag" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="FontSize" Value="11.5"/><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="local:Ui.CornerRadius" Value="11"/><Setter Property="local:Ui.HoverBrush" Value="#141F6FFF"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="13"/><Setter Property="local:Ui.CornerRadius" Value="16"/>
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="local:Ui.HoverBrush" Value="#1F000000"/>
   <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=CancelButton}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="16,16,16,12" FlowDirection="LeftToRight">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="LauncherRow" Height="72"/></Grid.RowDefinitions>
  <Border x:Name="Panel" FlowDirection="RightToLeft" Background="{DynamicResource Surface}" CornerRadius="18" Visibility="Collapsed" RenderTransformOrigin="0.08,1">
   <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.16" Color="#0B2A55"/></Border.Effect>
   <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="PanelScale"/><TranslateTransform x:Name="PanelSlide"/></TransformGroup></Border.RenderTransform>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

    <!-- Header -->
    <Border x:Name="HeaderBar" CornerRadius="18,18,0,0" Background="{StaticResource BrandBrush}" Padding="12,10,8,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="LookButton" Style="{StaticResource HeaderIconButton}" Width="34" Height="34" local:Ui.CornerRadius="17" Background="#2EFFFFFF" VerticalAlignment="Center" Click="PickLook" ToolTip="שינוי צבע וסמל" AutomationProperties.Name="שינוי צבע וסמל"><TextBlock x:Name="HeaderGlyph" Text="&#xE8BD;" FontSize="15"/></Button>
      <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
       <Button x:Name="ChatTypePicker" Style="{StaticResource HeaderIconButton}" Width="Auto" Height="Auto" Padding="6,2" Margin="-6,0,0,0" local:Ui.CornerRadius="9" HorizontalAlignment="Left" FontFamily="Segoe UI" Click="PickChatType" ToolTip="החלפת עוזר" AutomationProperties.Name="בחירת עוזר">
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="ChatTypeName" Text="כללי" FontSize="15" FontWeight="SemiBold" MaxWidth="150" TextTrimming="CharacterEllipsis"/><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,3,0,0" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <TextBlock x:Name="Status" Text="מוכן לשיחה" Foreground="#DDE8FF" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="NewChatButton" Style="{StaticResource HeaderIconButton}" Content="&#xE710;" ToolTip="שיחה חדשה" AutomationProperties.Name="שיחה חדשה" Click="NewChat"/>
       <Button x:Name="HistoryTab" Style="{StaticResource HeaderIconButton}" Content="&#xE81C;" ToolTip="היסטוריית שיחות" AutomationProperties.Name="היסטוריית שיחות" Click="History"/>
       <Button Style="{StaticResource HeaderIconButton}" FlowDirection="LeftToRight" Content="&#xE712;" ToolTip="אפשרויות" AutomationProperties.Name="אפשרויות" Click="ShowOptions"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Body -->
    <Border Grid.Row="1" CornerRadius="0,0,18,18" Background="{DynamicResource Canvas}">
     <Grid>
      <Grid x:Name="ChatPage">
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,8,4">
        <StackPanel>
         <!-- Each chat type gets its own landing page: color, icon, name, kind and sources. -->
         <StackPanel x:Name="Welcome" Margin="4,26,4,10">
          <Border x:Name="WelcomeIconCircle" Width="58" Height="58" CornerRadius="29" Background="{StaticResource BrandBrush}" HorizontalAlignment="Center">
           <Border.Effect><DropShadowEffect x:Name="WelcomeGlow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#1F6FFF"/></Border.Effect>
           <TextBlock x:Name="WelcomeIcon" Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="WelcomeTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,12,0,6"/>
          <Border x:Name="WelcomeKindBadge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Background="{DynamicResource Selected}"><TextBlock x:Name="WelcomeKind" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Link}"/></Border>
          <TextBlock x:Name="WelcomeText" Foreground="{DynamicResource Muted}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="10,10,10,0" LineHeight="18"/>
          <WrapPanel x:Name="WelcomeSources" HorizontalAlignment="Center" Margin="6,12,6,0"/>
         </StackPanel>
         <StackPanel x:Name="Messages"/>
         <Grid x:Name="Typing" Visibility="Collapsed" Margin="0,6,0,12" AutomationProperties.Name="Chaty מכין תשובה">
          <Grid.Resources><Storyboard x:Key="TypingMotion" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15" AutoReverse="True"/><DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3" AutoReverse="True"/></Storyboard></Grid.Resources>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrandBrush}" VerticalAlignment="Bottom" Margin="7,0,0,0"><Path Data="{StaticResource ChatShape}" Fill="White" Width="12" Height="11" Stretch="Uniform"/></Border>
          <Border HorizontalAlignment="Right" Background="{DynamicResource Surface}" CornerRadius="16,16,4,16" Padding="12,9">
           <StackPanel Orientation="Horizontal"><Ellipse x:Name="Dot1" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="2,0"/><Ellipse x:Name="Dot2" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="2,0"/><Ellipse x:Name="Dot3" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="2,0"/>
            <TextBlock Text="{Binding Text, ElementName=Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
          </Border>
         </Grid>
        </StackPanel>
       </ScrollViewer>
       <WrapPanel x:Name="Suggestions" Grid.Row="1" Margin="12,6,12,0"/>
       <Border x:Name="Composer" Grid.Row="2" Margin="12,2,12,0" CornerRadius="12" BorderThickness="1" Padding="12,2,4,2">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Grid VerticalAlignment="Center">
          <TextBox x:Name="Question" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="110" Padding="0,7" FontSize="13.5" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" PreviewKeyDown="QuestionKey" AutomationProperties.Name="השאלה שלכם"/>
          <TextBlock Text="כתבו את השאלה שלכם…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="2,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Question}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         </Grid>
         <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0,0,2">
          <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Width="32" Height="32" local:Ui.CornerRadius="16" Background="{DynamicResource Subtle}" Foreground="{DynamicResource Ink}" FontSize="11" Content="&#xE71A;" Visibility="Collapsed" Click="Cancel" ToolTip="עצירה" AutomationProperties.Name="עצירת הפעולה"/>
          <Button x:Name="SendButton" Style="{StaticResource SendButton}" Click="Send" ToolTip="שליחה · Enter" AutomationProperties.Name="שלח"><Path Data="M 18,0 L 0,8 L 18,16 L 15,9 L 6,8 L 15,7 Z" Fill="White" Width="13" Height="13" Stretch="Uniform" FlowDirection="LeftToRight" Margin="0,0,2,0"/></Button>
         </Grid>
        </Grid>
       </Border>
       <!-- Answer mode: at most one tag is on; none = regular search. -->
       <StackPanel x:Name="ModeBar" Grid.Row="3" Orientation="Horizontal" Margin="12,6,12,0" AutomationProperties.Name="סוג החיפוש">
        <Button x:Name="QuickModeButton" Style="{StaticResource ModeTag}" Click="ToggleMode" Tag="Quick" ToolTip="תשובה קצרה עם הקובץ הרלוונטי · מהיר וחוסך בשימוש ב־AI" AutomationProperties.Name="חיפוש מהיר">
         <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="חיפוש מהיר" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="DeepModeButton" Style="{StaticResource ModeTag}" Click="ToggleMode" Tag="Deep" ToolTip="חיפוש יסודי בכל מסמכי העוזר, גם במילים נרדפות · איטי יותר ומשתמש ביותר AI" AutomationProperties.Name="חיפוש מעמיק">
         <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="חיפוש מעמיק" VerticalAlignment="Center"/></StackPanel>
        </Button>
       </StackPanel>
       <TextBlock Grid.Row="4" FlowDirection="RightToLeft" Text="גם Chaty עלול לטעות. כדאי לבדוק מידע חשוב במקורות." FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="12,4,12,8" Opacity="0.85"/>
      </Grid>
      <local:HistoryPage x:Name="HistoryView" Visibility="Collapsed"/>
     </Grid>
    </Border>

    <Border x:Name="MenuScrim" Grid.RowSpan="2" Panel.ZIndex="19" Background="#330F2544" CornerRadius="18" Visibility="Collapsed"/>
    <Border x:Name="SettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Background="#660F2544" CornerRadius="18" Visibility="Collapsed" Padding="10">
     <ContentControl x:Name="SettingsHost" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/>
    </Border>
    <Border x:Name="LoginOverlay" Grid.RowSpan="2" Background="{DynamicResource Surface}" CornerRadius="18" Visibility="Visible" Padding="22">
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="ברוכים הבאים" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Border Background="{DynamicResource Selected}" CornerRadius="14" Padding="16"><TextBlock Text="אפליקציה זו מנוטרת על ידי הארגון" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/></Border>
      <TextBlock Text="השאלות, התשובות ונתוני השימוש נשמרים ביומן הארגוני. הגישה לשירות ולמקורות נקבעת לפי הרשאות חשבון הארגון שלכם." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,18"/>
      <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="כניסה עם חשבון הארגון" Click="Login"/>
      <TextBlock x:Name="LoginStatus" Text="הכניסה משתמשת בחשבון Windows המחובר למחשב." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <!-- Launcher: always visible, opens and closes the chat. -->
  <Button x:Name="Bubble" Focusable="False" Grid.Row="1" Width="54" Height="54" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Click="TogglePanel" ToolTip="פתיחת הצ׳אט" AutomationProperties.Name="פתיחה או סגירה של הצ׳אט" RenderTransformOrigin="0.5,0.5" FocusVisualStyle="{x:Null}">
   <Button.RenderTransform><ScaleTransform x:Name="BubbleScale"/></Button.RenderTransform>
   <Button.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#0B4FD8" Opacity="0.35"/></Button.Effect>
   <Button.Template><ControlTemplate TargetType="Button"><Grid>
    <Ellipse Fill="{StaticResource BrandBrush}"/><Ellipse x:Name="Shine" Fill="#26FFFFFF" Opacity="0"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Button.Template>
   <Button.Triggers>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
   </Button.Triggers>
   <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><RotateTransform x:Name="GlyphTurn"/></Grid.RenderTransform>
    <Path x:Name="ChatGlyph" Data="{StaticResource ChatShape}" Fill="White" Stretch="Uniform"/>
    <Path x:Name="CloseGlyph" Data="M 0,0 L 8,8 L 16,0" Width="16" Height="8" Stretch="Fill" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
   </Grid>
  </Button>
 </Grid>
</Window>
